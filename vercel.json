{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/b/:code",
      "destination": "https://kueoozsfkevmncucrdjd.supabase.co/functions/v1/google-business/b/:code"
    },
    {
      "source": "/p/fp/:token",
      "destination": "https://kueoozsfkevmncucrdjd.supabase.co/functions/v1/google-business/p/fp/:token"
    },
    {
      "source": "/seite/:slug",
      "destination": "/api/website?slug=:slug&pfad="
    },
    {
      "source": "/seite/:slug/:pfad*",
      "destination": "/api/website?slug=:slug&pfad=:pfad*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/website/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
